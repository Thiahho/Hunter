POSTGRES_DB=hunter
POSTGRES_USER=hunter
POSTGRES_PASSWORD=change_me_in_local_env

ASPNETCORE_ENVIRONMENT=Development

JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES_BASE64

WEBHOOKS_INBOUND_SECRET=change_me

WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_META_ACCESS_TOKEN
WHATSAPP_APP_SECRET=CHANGE_ME_META_APP_SECRET
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_me
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
WHATSAPP_TEMPLATE_BODY_PARAMETER_COUNT=1
WHATSAPP_TEMPLATE_SECOND_PARAMETER=
WHATSAPP_HANDOFF_TEMPLATE_NAME=
WHATSAPP_HANDOFF_TEMPLATE_LANGUAGE=es_AR

GOOGLE_PLACES_API_KEY=CHANGE_ME_GOOGLE_PLACES_API_KEY

# Envío automático de campañas Running. false = solo se envía a mano (POST /campaigns/{id}/process-queue).
CAMPAIGN_QUEUE_ENABLED=false
CAMPAIGN_QUEUE_POLL_INTERVAL_SECONDS=60

OSM_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=HunterCRM/1.0 (contact: CHANGE_ME_CONTACT_EMAIL)

NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=HunterCRM/1.0 (contact: CHANGE_ME_CONTACT_EMAIL)

# Fuente alternativa a OpenStreetMap para "Buscar prospectos": actor compass/crawler-google-places
# (Google Maps Scraper) en Apify Console. Servicio pago (~USD 1.50 cada 1000 lugares).
APIFY_API_TOKEN=CHANGE_ME_APIFY_API_TOKEN
APIFY_ACTOR_ID=compass~crawler-google-places

# Sin esto, las alertas de lead nuevo caen a StubTelegramNotifier (solo loguea). Token/username
# dados por @BotFather. WEBHOOK_SECRET es el secret_token usado al registrar el webhook (setWebhook).
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=CHANGE_ME_TELEGRAM_BOT_USERNAME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TELEGRAM_WEBHOOK_SECRET

CORS_ALLOWED_ORIGIN=http://localhost:5173
