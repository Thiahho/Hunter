# .NET build artifacts
backend/**/bin/
backend/**/obj/
*.user

# Local developer secrets (connection strings, JWT signing keys).
# Commit the corresponding *.example file instead.
backend/**/appsettings.Development.json
backend/**/appsettings.Local.json
backend/**/appsettings.*.local.json

# Environment / secrets
.env
docker/.env

# Clave de cuenta de servicio de Google (Drive sync) — nunca debería vivir en el repo, se pasa en
# base64 por variable de entorno (GoogleDrive__ServiceAccountKeyBase64). Cubre el nombre que
# Google Cloud Console genera por default y variantes comunes si alguien la renombra.
*service-account*.json
*serviceaccount*.json
google-drive-key*.json
gcp-key*.json

# Frontend (when it exists)
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# IDE
.vs/
.vscode/
*.DotSettings.user
.idea/

# OS
Thumbs.db
.DS_Store

# Logs
*.log

# Notas de trabajo internas (auditorías, planning) — no son parte del código
/auditoria.md
/medidas.md
