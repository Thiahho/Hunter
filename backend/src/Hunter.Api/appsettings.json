{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "HunterCrmAi",
    "Audience": "HunterCrmAi.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "WhatsAppCloudApi": {
    "ApiVersion": "v21.0",
    "TemplateLanguage": "es",
    "PhoneNumberId": "CHANGE_ME_PHONE_NUMBER_ID",
    "AccessToken": "CHANGE_ME_META_ACCESS_TOKEN",
    "WabaId": "CHANGE_ME_WHATSAPP_BUSINESS_ACCOUNT_ID",
    "AppSecret": "CHANGE_ME_META_APP_SECRET",
    "WebhookVerifyToken": "CHANGE_ME",
    "OrganizationId": 1,
    "TemplateName": "",
    "TemplateBodyParameterCount": 1,
    "TemplateSecondParameter": "",
    "TemplateQuickReplyPayloads": [],
    "HandoffTemplateName": "",
    "HandoffTemplateLanguage": "es"
  },
  "CampaignQueue": {
    "Enabled": false,
    "PollIntervalSeconds": 60
  },
  "OpenStreetMap": {
    "Endpoint": "https://overpass-api.de/api/interpreter",
    "UserAgent": "HunterCRM/1.0 (contact: CHANGE_ME_CONTACT_EMAIL)",
    "TimeoutSeconds": 60
  },
  "Apify": {
    "ApiToken": "CHANGE_ME_APIFY_API_TOKEN",
    "ActorId": "compass~crawler-google-places",
    "TimeoutSeconds": 280
  },
  "Nominatim": {
    "Endpoint": "https://nominatim.openstreetmap.org/search",
    "UserAgent": "HunterCRM/1.0 (contact: CHANGE_ME_CONTACT_EMAIL)",
    "TimeoutSeconds": 10
  },
  "Telegram": {
    "BotToken": "",
    "BotUsername": "",
    "WebhookSecret": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
