{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "HunterCrmAi",
    "Audience": "HunterCrmAi.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "WhatsAppCloudApi": {
    "ApiVersion": "v21.0",
    "TemplateLanguage": "es",
    "PhoneNumberId": "CHANGE_ME_PHONE_NUMBER_ID",
    "AccessToken": "CHANGE_ME_META_ACCESS_TOKEN",
    "AppSecret": "CHANGE_ME_META_APP_SECRET",
    "WebhookVerifyToken": "CHANGE_ME",
    "OrganizationId": 1,
    "TemplateName": "",
    "TemplateBodyParameterCount": 1,
    "TemplateSecondParameter": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
